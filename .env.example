# Where the FastAPI backend lives during `npm run dev`.
# Leave unset to use the default (http://127.0.0.1:8501).
VITE_API_PROXY="http://127.0.0.1:8501"

# Absolute API origin for production builds, where there is no Vite proxy.
# Leave unset if the API is served from the same origin as the frontend.
VITE_API_BASE_URL=""
